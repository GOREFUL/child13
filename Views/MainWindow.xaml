<Window x:Class="child13.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:child13"
        mc:Ignorable="d"
        Title="child13"
        WindowStyle="ThreeDBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        MinWidth="450" MinHeight="130" Loaded="Window_Loaded"
        Height="450" Width="800" Closed="Window_Closed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles/MainTextBox.xaml"/>
                <ResourceDictionary Source="../Resources/Styles/MainLabel.xaml"/>
                <ResourceDictionary Source="../Resources/Styles/MainButton.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Button x:Name="_btnCoordinate"
                Grid.Row="0" Margin="5" FontSize="14" Click="OpenCoordinateWindowButton_Click"/>
            <Button x:Name="_btnTompost"
                Grid.Row="1" Margin="5" FontSize="14" Click="Tompost_mode_Click"/>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Grid.Column="0" Grid.Row="0" x:Name="_btnFirstClear" Click="btnFirstClear_Click" Margin="5"/>
            <Button Grid.Column="1" Grid.Row="0" x:Name="_btnSecondClear" Click="btnSecondClear_Click" Margin="5"/>
            <Button Grid.Column="2" Grid.Row="0" x:Name="_btnThirdClear" Click="btnThirdClear_Click" Margin="5"/>
            <Button Grid.Column="0" Grid.Row="1" x:Name="_btnFirst" Click="btnFirst_Click" Margin="5"/>
            <Button Grid.Column="1" Grid.Row="1" x:Name="_btnSecond" Click="btnSecond_Click" Margin="5"/>
            <Button Grid.Column="2" Grid.Row="1" x:Name="_btnThird" Click="btnThird_Click" Margin="5"/>
            <Button Grid.Column="3" Grid.Row="0" x:Name="_btnClearAll" Grid.RowSpan="2" Click="_btnClear_Click" Margin="5"/>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="0">
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                <TextBlock x:Name="_txtSettings" FontWeight="Bold" FontSize="12"
                       Width="121" TextAlignment="Center"
                       Height="35" TextWrapping="WrapWithOverflow"/>
                <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                    <Label x:Name="_lblFont" HorizontalAlignment="Left"/>
                    <ComboBox x:Name="_cbFont" Width="120"
                          SelectionChanged="FontComboBox_SelectionChanged">
                        <ComboBoxItem Content="Arial" />
                        <ComboBoxItem Content="Times New Roman" />
                        <ComboBoxItem Content="Calibri" />
                        <ComboBoxItem Content="Verdana" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                    <Label x:Name="_lblSize" HorizontalAlignment="Left"/>
                    <ComboBox x:Name="_cbFontSize" Width="120"
                          SelectionChanged="FontSizeComboBox_SelectionChanged">
                        <ComboBoxItem Content="12"/>
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="16"/>
                        <ComboBoxItem Content="18"/>
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="22"/>
                        <ComboBoxItem Content="24"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="_chbBold" Content="Bold" Checked="BoldCheckBox_Checked" Unchecked="BoldCheckBox_Unchecked" />
                    <CheckBox x:Name="_chbItalic" Content="Italic" Checked="ItalicCheckBox_Checked" Unchecked="ItalicCheckBox_Unchecked" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                    <Label x:Name="_lblBack" HorizontalAlignment="Left"/>
                    <ComboBox x:Name="_cbBack" Width="120" SelectionChanged="BackgroundColorComboBox_SelectionChanged">
                        <ComboBoxItem x:Name="_cbItemWhite" Background="White"/>
                        <ComboBoxItem x:Name="_cbItemBlack" Background="Black"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="_txtOriginal" Grid.Row="0" IsEnabled="False" Margin="0,50,0,0"
                    VerticalAlignment="Top"/>
            <TextBlock x:Name="_txtTranslate" Grid.Row="1" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
