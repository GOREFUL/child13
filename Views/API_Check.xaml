<Window x:Class="child13.Views.API_Check"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:child13.Views"
        mc:Ignorable="d"
                ResizeMode="NoResize" WindowStyle="ToolWindow"
        Title="API_Check" Height="200" Width="400"
        Background="Black" WindowStartupLocation="CenterScreen" Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
               FontSize="20" FontWeight="Bold" Content="API Check"
               Foreground="LightGray" x:Name="_lblApi"/>


        <TextBox Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="16" FontWeight="Bold" TextWrapping="Wrap"
                 x:Name="_txtAPICheck" 
                 Background="Black" 
                 Foreground="LightGray" 
                 BorderBrush="LightGray"
                 BorderThickness="2">
        </TextBox>

        <Button Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                FontSize="16" FontWeight="Bold" Content="Input API key" x:Name="_btnApi"
                Background="Black" 
                Foreground="LightGray"
                BorderBrush="LightGray"
                BorderThickness="2"
                Click="Button_Click"/>
    </Grid>
</Window>

